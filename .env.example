# Copy to .env and adjust. Every variable is read only by backend/src/apicost/config.py
# (CLAUDE.md hard rule 8) and must carry the APICOST_ prefix.
#
# .env is gitignored. Never commit a real key.

# --- Environment -------------------------------------------------------------
APICOST_ENVIRONMENT=local
APICOST_DEBUG=false

# --- Logging -----------------------------------------------------------------
APICOST_LOG_LEVEL=INFO
# false gives human-readable console output instead of JSON
APICOST_LOG_JSON=true

# --- Datastores --------------------------------------------------------------
# Host values, for running tests and alembic outside the containers. Inside
# compose these are overridden to the service names postgres/redis.
#
# Postgres is published on 5433, not 5432, so a system Postgres on the default
# port is never hit by our migrations. See docker-compose.yml.
APICOST_DATABASE_URL=postgresql+asyncpg://apicost:apicost@localhost:5433/apicost
APICOST_REDIS_URL=redis://localhost:6379/0

# --- Time budgets (BUILD_SPEC §0.1) ------------------------------------------
APICOST_OPTIMIZATION_BUDGET_MS=150
APICOST_EMBEDDING_BUDGET_MS=40

# --- Secrets -----------------------------------------------------------------
# LocalKMS master key, used from P1. In staging/production the AWS KMS
# implementation is used instead and this stays unset.
APICOST_KMS_MASTER_KEY=local-dev-master-key-do-not-use-in-prod
APICOST_JWT_SECRET=local-dev-jwt-secret-do-not-use-in-prod

# --- Email (mailpit in local dev) --------------------------------------------
APICOST_SMTP_HOST=localhost
APICOST_SMTP_PORT=1025
APICOST_EMAIL_FROM=apicost@localhost

# --- Web ---------------------------------------------------------------------
APICOST_CORS_ORIGINS=["http://localhost:5173"]
